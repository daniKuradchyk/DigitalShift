# Dominio público del sitio. Se usa para canonical, og:url, JSON-LD y sitemap.
# En producción lo fija netlify.toml. Si falta, se usa https://qubelia.es como fallback.
NEXT_PUBLIC_SITE_URL=https://qubelia.es

# Public analytics
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Public contact fallback
NEXT_PUBLIC_CONTACT_EMAIL=hola@qubelia.es
